{
  "name": "difflib-ts",
  "version": "1.0.3",
  "description": "Port of qiao/difflib to Typescript and modern node and browser support",
  "scripts": {
    "clean": "rimraf dist",
    "rollup": "rollup -c config/rollup.config.js",
    "build": "npm run clean && npm run rollup",
    "benchmark": "npm run build && node benchmark/performance.mjs",
    "test": "jest",
    "prepack": "npm run build"
  },
  "author": {
    "name": "George Borrelli",
    "url": "https://github.com/borie88"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mailmangroup/difflib-ts.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.26.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
