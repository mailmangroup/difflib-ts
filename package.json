{
  "name": "@mailmangroup/difflib-ts",
  "version": "1.0.3",
  "description": "Port of qiao/difflib to Typescript and modern node and browser support",
  "author": {
    "name": "George Borrelli",
    "url": "https://github.com/borie88"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailmangroup/difflib-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "benchmark": "npm run build && node benchmark/performance.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    }
  }
}
